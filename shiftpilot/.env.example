# Copy to .env.local and fill in.

# Postgres connection string (Neon, Supabase or local)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Protects the manager dashboard when it's reachable through the tunnel (username can be anything)
DASHBOARD_PASSWORD=

# OpenRouter: one key for both Jev (decisions) and the chat model
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
LLM_MODEL=openai/gpt-6-sol
# jev_then_llm (default) | jev | llm
UNDERSTANDING_MODE=jev_then_llm

# WhatsApp Cloud API (Meta developer app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings -> Basic -> App secret; used to verify webhook signatures
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Template used to open a conversation outside the 24-hour window.
# hello_world works out of the box; a custom utility template with one {{1}} body variable is better.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_HAS_BODY_PARAM=false

# Optional: Google Sheets roster export (service account with edit access to the sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Roster

# Seconds between background agent runs (reminders, timeouts)
AGENT_TICK_SECONDS=30
